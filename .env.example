# Optional overrides for docker compose (copy to .env in the repo root).
# Defaults in docker-compose.yml are fine for local review — no secrets required.

LOG_LEVEL=info
JWT_SECRET=local-dev-only-jwt-secret-change-me-0123456789
OTP_SECRET=local-dev-only-otp-secret-change-me-0123456789
BCRYPT_COST=12
JWT_EXPIRES_IN=7d
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=5
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=PadosiPro <no-reply@padosipro.local>
AUTH_RATE_LIMIT_PER_MINUTE=30
