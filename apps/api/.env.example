# API environment variables (copy to .env and adjust as needed).
# All values below are safe local defaults — never commit real secrets.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
LOG_PRETTY=true

DATABASE_URL=postgres://padosi:padosi@localhost:5433/padosipro

JWT_SECRET=local-dev-only-jwt-secret-change-me-0123456789
JWT_EXPIRES_IN=7d
BCRYPT_COST=12

OTP_SECRET=local-dev-only-otp-secret-change-me-0123456789
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=5

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=PadosiPro <no-reply@padosipro.local>

AUTH_RATE_LIMIT_PER_MINUTE=30
