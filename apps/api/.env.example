# Copy to apps/api/.env for local (non-Docker) API runs: cp .env.example .env
# Prefer `docker compose up` from the repo root — Compose already wires defaults.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres (docker compose exposes the database on localhost:5433)
DATABASE_URL=postgres://padosi:padosi@localhost:5433/padosipro

# Auth. Use long random strings, e.g. `openssl rand -hex 32`.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_COST=12

# OTP. OTP_SECRET is the HMAC key used to hash codes before storing them.
OTP_SECRET=replace-with-another-long-random-string-32-chars
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=5

# SMTP. Defaults point at Mailpit (web inbox: http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PadosiPro <no-reply@padosipro.local>"

# Requests per minute per IP on auth endpoints
AUTH_RATE_LIMIT_PER_MINUTE=30
