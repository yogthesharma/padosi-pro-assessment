{
  "name": "@padosipro/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Validation schemas, error codes and API types shared by the API and the mobile app.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@padosipro/typescript-config": "*",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
